# Read-write token for the PRIVATE Vercel Blob store.
# Added automatically when you connect the store to the project (Storage tab).
# Client-upload tokens are signed with it, so it's required even when OIDC is available.
BLOB_READ_WRITE_TOKEN=

# Password for /admin.
ADMIN_PASSWORD=

# Random secret (32+ chars) used to sign the admin session cookie.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_SECRET=
